{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["userId", "username", "books"],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "books": {
      "type": "array",
      "items": {
        "$ref": "book.json"
      }
    }
  }
}
