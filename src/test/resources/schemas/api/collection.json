{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["books"],
  "properties": {
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["isbn"],
        "properties": {
          "isbn": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
