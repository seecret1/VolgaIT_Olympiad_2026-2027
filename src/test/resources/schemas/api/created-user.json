{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["username", "books"],
  "anyOf": [
    {
      "required": ["userID"]
    },
    {
      "required": ["userId"]
    }
  ],
  "properties": {
    "userID": {
      "type": "string",
      "minLength": 1
    },
    "userId": {
      "type": "string",
      "minLength": 1
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "books": {
      "type": "array"
    }
  }
}
