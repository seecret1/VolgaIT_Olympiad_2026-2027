{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["isbn", "title", "subTitle", "author", "publish_date", "publisher", "pages", "description", "website"],
  "properties": {
    "isbn": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subTitle": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "publish_date": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "minLength": 1
    }
  }
}
